generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               BigInt   @id @default(autoincrement())
  email            String?  @unique @db.VarChar(255)
  name             String?  @db.VarChar(100)
  password         String?  @db.VarChar(255)
  provider         String?  @db.VarChar(20)
  providerId       String?  @unique @db.VarChar(100)
  isPassVerified   Boolean  @default(false)
  passCi           String?  @unique @db.VarChar(255)
  profileImage     String?  @db.VarChar(500)
  kakaoNickname    String?  @db.VarChar(100)
  kakaoProfileImage String? @db.VarChar(500)
  kakaoEmail       String?  @db.VarChar(255)
  naverNickname    String?  @db.VarChar(100)
  naverProfileImage String? @db.VarChar(500)
  naverEmail       String?  @db.VarChar(255)
  localNickname    String?  @db.VarChar(100)
  localEmail       String?  @db.VarChar(255)
  primaryAccountProvider String? @default("local") @db.VarChar(20)
  preferredImageProvider String? @default("kakao") @db.VarChar(20)
  preferredNameProvider  String? @default("kakao") @db.VarChar(20)
  refreshToken     String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  deletedAt        DateTime? @db.Timestamp(6)

  insuranceProducts    InsuranceProduct[]
  notificationSettings UserNotificationSettings?
  loginHistories       UserLoginHistory[]
  documents            Document[]
  notifications        Notification[]
}

model UserLoginHistory {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  device    String   @db.VarChar(100)
  ipAddress String   @db.VarChar(50)
  location  String?  @db.VarChar(100)
  loginAt   DateTime @default(now()) @db.Timestamp(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotificationSettings {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @unique
  pushEnabled     Boolean  @default(true)
  emailEnabled    Boolean  @default(false)
  kakaoEnabled    Boolean  @default(true)
  quietHoursStart String?  @db.VarChar(5)
  quietHoursEnd   String?  @db.VarChar(5)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InsuranceProduct {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt
  category       String   @db.VarChar(20)
  name           String   @db.VarChar(200)
  institution    String   @db.VarChar(100)
  startDate      DateTime @db.Date
  maturityDate   DateTime @db.Date
  monthlyPayment Int
  coverageAmount BigInt
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
  documents     Document[]
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  productId BigInt?
  type      String   @db.VarChar(20)
  title     String   @db.VarChar(200)
  message   String   @db.Text
  channel   String   @default("in_app") @db.VarChar(20)
  isRead    Boolean  @default(false)
  sentAt    DateTime @default(now()) @db.Timestamp(6)
  status    String   @default("sent") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product InsuranceProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Document {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  productId  BigInt?
  fileName   String   @default("document") @db.VarChar(255)
  fileUrl    String   @db.VarChar(500)
  fileSize   Int      @default(0)
  mimeType   String   @default("application/pdf") @db.VarChar(100)
  ocrText    String?  @db.Text
  parsedData Json?
  uploadedAt DateTime @default(now()) @db.Timestamp(6)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product InsuranceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
}
