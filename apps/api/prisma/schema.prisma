generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt   @id @default(autoincrement())
  email     String   @db.VarChar(255)
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  deletedAt DateTime? @db.Timestamp(6)

  insuranceProducts    InsuranceProduct[]
  notificationSettings UserNotificationSettings?
}

model UserNotificationSettings {
  id              BigInt   @id @default(autoincrement())
  userId          BigInt   @unique
  pushEnabled     Boolean  @default(true)
  emailEnabled    Boolean  @default(false)
  kakaoEnabled    Boolean  @default(true)
  quietHoursStart String?  @db.VarChar(5)
  quietHoursEnd   String?  @db.VarChar(5)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InsuranceProduct {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt
  category       String   @db.VarChar(20)
  name           String   @db.VarChar(200)
  institution    String   @db.VarChar(100)
  startDate      DateTime @db.Date
  maturityDate   DateTime @db.Date
  monthlyPayment Int
  coverageAmount BigInt
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @db.Timestamp(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
  documents     Document[]
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  productId BigInt
  type      String   @db.VarChar(10)
  channel   String   @db.VarChar(20)
  sentAt    DateTime @db.Timestamp(6)
  status    String   @db.VarChar(20)

  product InsuranceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Document {
  id         BigInt   @id @default(autoincrement())
  productId  BigInt
  fileUrl    String   @db.VarChar(500)
  ocrText    String?  @db.Text
  parsedData Json?
  uploadedAt DateTime @default(now()) @db.Timestamp(6)

  product InsuranceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}
