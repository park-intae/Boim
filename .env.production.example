# ==============================================================================
# Boim 상용 환경 변수 템플릿 (.env.production.example)
# ==============================================================================
# ⚠️ 보안 주의사항:
# - 본 파일(.env.production.example)은 템플릿 예시이며 절대 실제 상용 비밀키를 기재하지 마십시오.
# - 상용 서버 배포 시 이 파일을 '.env.production'으로 복사한 후 안전한 비밀값으로 설정하십시오.
# - 생성된 실제 .env.production 파일은 절대로 Git 저장소에 커밋/푸시해서는 안 됩니다 (.gitignore 필수 등록).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 런타임 및 네트워크 포트 설정
# ------------------------------------------------------------------------------
NODE_ENV=production
API_PORT=4000
WEB_PORT=80

# ------------------------------------------------------------------------------
# 2. 데이터베이스 설정 (PostgreSQL 16 Alpine)
# ------------------------------------------------------------------------------
POSTGRES_USER=boim_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_STRONG_RANDOM_PASSWORD_HERE
POSTGRES_DB=boim

# Docker Compose 환경 내부 네트워크 연결 URL (호스트명: postgres)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 3. 인증 및 보안 (JWT)
# ------------------------------------------------------------------------------
# 💡 TIP: 'openssl rand -hex 64' 명령어로 생성된 강력한 128자 이상의 랜덤 16진수 문자열을 사용하십시오.
JWT_SECRET=GENERATE_A_MINIMUM_64_BYTE_RANDOM_HEX_SECRET_STRING_HERE
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. 프론트엔드 도메인 및 CORS 허용 주소
# ------------------------------------------------------------------------------
# 실제 상용 서비스 도메인 (HTTPS 권장)
FRONTEND_URL=https://boim.yourdomain.com

# ------------------------------------------------------------------------------
# 5. 소셜 로그인 OAuth2 (카카오 / 네이버)
# ------------------------------------------------------------------------------
# 카카오 디벨로퍼스 (https://developers.kakao.com) 앱 키
KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET_CODE
KAKAO_CALLBACK_URL=https://boim.yourdomain.com/api/auth/kakao/callback

# 네이버 개발자센터 (https://developers.naver.com) 오픈 API 키
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
NAVER_CALLBACK_URL=https://boim.yourdomain.com/api/auth/naver/callback

# ------------------------------------------------------------------------------
# 6. Google Gemini AI 종합 진단 및 파서
# ------------------------------------------------------------------------------
# Google AI Studio (https://aistudio.google.com)에서 발급받은 상용 API 키
GEMINI_API_KEY=YOUR_GEMINI_PRODUCTION_API_KEY
# 상용 운영 시 반드시 false로 지정하여 실제 Gemini AI 엔진 활성화
USE_MOCK_PARSER=false

# ------------------------------------------------------------------------------
# 7. 이메일 알림 발송 (SMTP)
# ------------------------------------------------------------------------------
ENABLE_EMAIL_NOTIFICATION=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-service-account@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Boim 보험 관리 알림" <noreply@yourdomain.com>
